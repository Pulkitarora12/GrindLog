// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Series {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String?
  isEnded      Boolean    @default(false)
  endedAt      DateTime?
  endingReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  entries      DayEntry[]
}

// One "what I did" entry. A day can have as many entries as needed.
model DayEntry {
  id        String       @id @default(cuid())
  date      DateTime
  text      String
  seriesId  String?
  series    Series?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  images    EntryImage[]
  createdAt DateTime     @default(now())

  @@index([date])
}

// Proof-of-work photo stored on Cloudinary.
model EntryImage {
  id        String   @id @default(cuid())
  entryId   String
  entry     DayEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  createdAt DateTime @default(now())
}
